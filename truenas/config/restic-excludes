# restic --exclude-file for vault-nightly.sh. What stays on the vault only.

# Credentials: in the password manager, never off-site in the same place as
# the data they unlock.
/mnt/vault/system/secrets

# Oracle has ~77 GiB free. Large and replaceable: VM disks. The automotive
# VMs (Personal/VMs, 40 GB) live on the vault only, by choice: not critical,
# and RAIDZ3 is their protection.
/mnt/vault/files/Personal/VMs
*.qcow2
*.vmdk
*.vdi

# The PS5 console backup (NAS backups/ps5, ~13 GB a copy, every copy kept): encrypted by the
# console, so restic dedupes nothing between copies. NAS + vault only, by
# choice; the vault's snapshots are its history.
/mnt/vault/backup/nas/backups/ps5

# Run state: locks, the drill's scratch directory.
/mnt/vault/system/run
