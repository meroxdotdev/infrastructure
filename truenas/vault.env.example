# Template for /mnt/vault/system/secrets/vault.env (0600, root). The real file
# never enters this public repository: it holds the wake time, which is the one
# thing worth hiding about a machine that keeps the offline copies, and the
# credentials below. Copy of the real values: password manager.

# Wake time, local. pve-3's /etc/cron.d/vault-wake must say the same.
W=HH:MM

NAS_HOST=10.57.57.201
ORACLE_HOST=100.72.22.38

# healthchecks.io check "vault-nightly": cron schedule at W, Europe/Bucharest,
# grace 60 min. /start, success and /fail are all sent to it.
HC_URL=https://hc-ping.com/<uuid>

# A bot of its own, not the alerting one: the gate reads updates from it, and
# a second reader (or a webhook) on the same bot would steal the button presses.
TG_TOKEN=<bot token>
TG_CHAT=<chat id>
