
services:
  traefik:
    image: {{ traefik_image }}
    container_name: traefik
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    networks:
      {{ traefik_network_name }}:
        ipv4_address: {{ traefik_container_ip }}
    ports:
      # The tailnet address, never 0.0.0.0 — the same rule pihole, portainer
      # and the rest-server follow on this host.
      #
      # This is the whole access control. Pi-hole resolves *.cloud.merox.dev
      # here, so internal clients reach the proxy on these ports, and nothing
      # off the tailnet can open them at all — including from the internet,
      # where the OCI security list still allows :443 and would otherwise let
      # anyone reach sso/rmt directly with a Host header, bypassing the
      # Cloudflare proxy. Publishing on 0.0.0.0 here re-opens that hole even
      # though no router is bound to a "public" entrypoint any more.
      #
      # cloudflared does not use these ports: it dials the container's bridge
      # address. docker_setup holds docker's start until this address exists.
      - "{{ traefik_bind_ip }}:80:80"
      - "{{ traefik_bind_ip }}:443:443"
    dns:
      - 1.1.1.1
      - 8.8.8.8
    environment:
      CF_DNS_API_TOKEN_FILE: /run/secrets/cf_api_token
      TRAEFIK_DASHBOARD_CREDENTIALS: ${TRAEFIK_DASHBOARD_CREDENTIALS}
    secrets:
      - cf_api_token
    env_file: .env
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ traefik_docker_dir }}/data/traefik.yml:/traefik.yml:ro
      - {{ traefik_docker_dir }}/data/acme.json:/acme.json
      - {{ traefik_docker_dir }}/config:/config:ro
      # Access log lives on the host so fail2ban, which runs outside the
      # container, can read it.
      - {{ traefik_log_dir }}:/var/log/traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.traefik.entrypoints=http"
      - "traefik.http.routers.traefik.rule=Host(`{{ traefik_domain }}`)"
      - "traefik.http.middlewares.traefik-auth.basicauth.users=${TRAEFIK_DASHBOARD_CREDENTIALS}"
      - "traefik.http.middlewares.traefik-https-redirect.redirectscheme.scheme=https"
      - "traefik.http.middlewares.sslheader.headers.customrequestheaders.X-Forwarded-Proto=https"
      - "traefik.http.routers.traefik.middlewares=traefik-https-redirect"
      - "traefik.http.routers.traefik-secure.entrypoints=https"
      - "traefik.http.routers.traefik-secure.rule=Host(`{{ traefik_domain }}`)"
      - "traefik.http.routers.traefik-secure.middlewares=traefik-auth"
      - "traefik.http.routers.traefik-secure.tls=true"
      - "traefik.http.routers.traefik-secure.tls.certresolver=cloudflare"
      - "traefik.http.routers.traefik-secure.tls.domains[0].main={{ traefik_wildcard_domain }}"
      - "traefik.http.routers.traefik-secure.tls.domains[0].sans=*.{{ traefik_wildcard_domain }}"
      - "traefik.http.routers.traefik-secure.service=api@internal"

secrets:
  cf_api_token:
    file: ./cf_api_token.txt

networks:
  {{ traefik_network_name }}:
    external: true
