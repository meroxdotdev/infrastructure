api:
  dashboard: true
  debug: false

# Two deliberately separate paths:
#
#   https   :443   container port only. NOT published to the host any more —
#                  the Cloudflare tunnel reaches it over the docker bridge at
#                  172.25.10.2:443. Serves everything that existed before, so
#                  the ~9 `entrypoints=https` labels stay untouched.
#   public  :8443  container port, published as host :443 and opened in the
#                  Oracle NSG. ONLY the jellyfin router binds to it, so a
#                  request to the public IP with `Host: sso.merox.dev` gets a
#                  404 — that router does not exist on this port.
#
# asDefault on `https`: a router with no `entryPoints` otherwise binds to ALL
# entrypoints (doc.traefik.io/traefik/reference/install-configuration/
# entrypoints/). With this, anything forgotten stays private rather than
# exposed to the internet.
entryPoints:
  http:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: public
          scheme: https
  https:
    address: ":443"
    asDefault: true
  public:
    address: ":8443"

# Access log. Two reasons: nothing else records who reached the public
# entrypoint, and fail2ban needs a file to read failed logins from.
#
# Only 4xx/5xx are kept. Successful playback would otherwise write a line per
# HLS segment and drown the signal.
#
# Jellyfin sometimes carries an api_key in the query string, and RequestPath
# includes it. The file is therefore root-only and rotated; do not relax those
# permissions or ship it somewhere less protected.
accessLog:
  filePath: /var/log/traefik/access.log
  format: json
  bufferingSize: 50
  filters:
    statusCodes:
      - "400-499"
      - "500-599"
  fields:
    headers:
      defaultMode: drop
      names:
        User-Agent: keep

serversTransport:
  insecureSkipVerify: true

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
  file:
    directory: /config

certificatesResolvers:
  cloudflare:
    acme:
      email: {{ cloudflare_email }}
      storage: acme.json
      caServer: https://acme-v02.api.letsencrypt.org/directory
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"
