# Syncthing, encrypted-only node for the 24/7 shared folder.
#
# Bound to the tailnet address: sync traffic never touches the internet, and
# global discovery and relays are off in Syncthing's own options. The GUI is
# on loopback only — reach it with `ssh -L 8384:127.0.0.1:8384`.
services:
  syncthing:
    image: {{ syncthing_image }}
    container_name: syncthing
    hostname: vps01
    restart: unless-stopped
    environment:
      PUID: "{{ syncthing_uid }}"
      PGID: "{{ syncthing_uid }}"
      STGUIADDRESS: 0.0.0.0:8384
    volumes:
      - {{ syncthing_docker_dir }}:/var/syncthing
    ports:
      - "{{ syncthing_listen_ip }}:22000:22000/tcp"
      - "{{ syncthing_listen_ip }}:22000:22000/udp"
      - "127.0.0.1:8384:8384"
