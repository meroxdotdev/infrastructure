---
# Append-only REST endpoint in front of the restic repository at
# /srv/restic-repo/data.
#
# Why it exists: a client that can prune can delete the off-site copy. Root on
# the backup host - ransomware, a wrong command, a container that escapes -
# would take the last copy with it. Through this endpoint the vault can add
# snapshots and never remove one; retention runs here instead.
#
# --append-only lets a client add data and denies deletion or modification of
# what is already there. Lock files are the documented exception, which is what
# keeps "restic backup", "restic check" and "restic unlock" working while
# "forget" and "prune" cannot run. Retention therefore has to live somewhere
# else: restic-retention.service on this host reaches the repository through the
# filesystem rather than through this port, so it keeps full control while the
# vault never has it. That asymmetry is the whole design.
#
# Bound to the tailnet address deliberately. On 0.0.0.0 this would be an
# internet-facing service on an Oracle tenancy that is not ours.
#
# Runs as the account that owns the repository, so what it writes stays
# readable to the retention job.
services:
  rest-server:
    image: {{ restic_rest_image }}
    container_name: rest-server
    restart: unless-stopped
    user: "{{ restic_rest_owner }}"
    environment:
      DATA_DIRECTORY: /data
      PASSWORD_FILE: /auth/.htpasswd
      OPTIONS: --append-only
    volumes:
      - {{ restic_rest_repo_path }}:/data
      - {{ restic_rest_docker_dir }}/auth:/auth:ro
    ports:
      - "{{ restic_rest_listen_ip }}:8000:8000"
