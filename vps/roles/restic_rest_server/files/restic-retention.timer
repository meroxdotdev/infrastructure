[Unit]
Description=Daily restic retention, after the nightly push has landed

[Timer]
# prune holds an exclusive lock. 05:00 UTC is well clear of the vault's daily
# push, whose hour is deliberately not written in this repository.
OnCalendar=*-*-* 05:00:00 UTC
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
