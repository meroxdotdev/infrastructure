#!/bin/bash
# Pulls telemetry Homepage has no native widget for, and writes one small
# flat JSON that the homelab-stats-server sidecar serves to the private
# Homepage over plain HTTP (internal docker network only). Also evaluates
# the same readings against thresholds and fires alerts on state changes -
# this is the one place hardware/power/storage health is watched from
# OUTSIDE the homelab, so it keeps working during a home-side outage that
# would take Alertmanager/n8n/Ollama down with it. Sources:
#  - R730xd's iDRAC (Redfish) - power draw + fan RPM. Read-only iDRAC
#    account (homepage-ro), no configure/power-control privilege.
#  - Proxmox VE API - ZFS pool usage per node. Built to scrape standalone
#    Proxmox hosts independently (no corosync cluster, each needs its own
#    API endpoint/token) to support more than one host if that ever happens.
#  - UPS state via pwrstat over a restricted SSH key is disabled (see below)
#    - the actual shutdown safety mechanism is unaffected, it runs locally
#    via NUT on pve. This only loses early Telegram warning of UPS state
#    changes.
# Deployed by ansible (app_stack_setup role).
set -euo pipefail

IDRAC_HOST="{{ vault_idrac_host }}"
IDRAC_USER="{{ vault_idrac_username }}"
IDRAC_PASS="{{ vault_idrac_password }}"

# node:host:token triples - one per standalone Proxmox host. Add another
# "name:ip:8006:user={{ homepage_proxmox_username }}={{ homepage_proxmox_password }}"
# entry to PVE_TARGETS below if a second Proxmox host ever exists.
{% if vault_pve_r730xd_username is defined %}
PVE_TARGETS=(
  "pve:10.57.57.250:8006:{{ vault_pve_r730xd_username }}={{ vault_pve_r730xd_password }}"
)
{% else %}
PVE_TARGETS=()
{% endif %}

# Alert delivery - optional/empty-safe so this deploys fine before Phase 0
# secrets exist; sending is skipped silently until they're filled in (see
# vps_backup_hc_* in roles/vps_backup/defaults/main.yml for the same
# empty-default convention used for backup healthchecks).
TELEGRAM_BOT_TOKEN="{{ vault_telegram_bot_token | default('') }}"
TELEGRAM_CHAT_ID="{{ vault_telegram_chat_id | default('') }}"

# Storage/fan alerts route through n8n for AI triage - UPS stays direct to
# Telegram above/below (must survive n8n itself being down during an
# outage). n8n.k8s.merox.dev has no public DNS record (by design, LAN/
# Tailscale-only) so it's resolved explicitly to the internal Gateway's
# fixed IP rather than relying on this VPS's public resolver to find it.
N8N_WEBHOOK_URL="https://n8n.k8s.merox.dev/webhook/hardware"
N8N_WEBHOOK_RESOLVE="n8n.k8s.merox.dev:443:10.57.57.101"
N8N_WEBHOOK_TOKEN="{{ vault_n8n_webhook_token | default('') }}"

OUT_DIR="{{ app_stack_dir }}/homelab-stats"
OUT_FILE="$OUT_DIR/homelab-stats.json"
STATE_FILE="$OUT_DIR/.alert-state.json"

CURL_CONF="$(mktemp)"
POWER_FILE="$(mktemp)"
THERMAL_FILE="$(mktemp)"
STORAGE_DIR="$(mktemp -d)"
PWRSTAT_FILE="$(mktemp)"
cleanup() { rm -rf "$CURL_CONF" "$POWER_FILE" "$THERMAL_FILE" "$STORAGE_DIR" "$PWRSTAT_FILE"; }
trap cleanup EXIT

chmod 600 "$CURL_CONF"
# iDRAC credentials via curl config file, not argv - keeps them out of `ps aux`.
printf 'user = "%s:%s"\ninsecure\n' "$IDRAC_USER" "$IDRAC_PASS" > "$CURL_CONF"

curl -sS -m 10 -K "$CURL_CONF" -o "$POWER_FILE" \
  "https://$IDRAC_HOST/redfish/v1/Chassis/System.Embedded.1/Power"
curl -sS -m 10 -K "$CURL_CONF" -o "$THERMAL_FILE" \
  "https://$IDRAC_HOST/redfish/v1/Chassis/System.Embedded.1/Thermal"

NODE_NAMES=()
for target in "${PVE_TARGETS[@]}"; do
  IFS=':' read -r node host port token <<< "$target"
  NODE_NAMES+=("$node")
  curl -sS -k -m 10 -H "Authorization: PVEAPIToken=$token" \
    -o "$STORAGE_DIR/$node.json" \
    "https://$host:$port/api2/json/nodes/$node/storage" || echo '{"data":[]}' > "$STORAGE_DIR/$node.json"
done

# Disabled: pwrstat-over-SSH source. PWRSTAT_FILE stays empty,
# ups.reachable becomes false downstream, no false alerts fire. Rebuild
# against NUT on pve directly (upsc cyberpower) instead if this needs
# re-enabling.

mkdir -p "$OUT_DIR"

python3 - "$POWER_FILE" "$THERMAL_FILE" "$STORAGE_DIR" "$PWRSTAT_FILE" \
  "$OUT_FILE" "$STATE_FILE" "$TELEGRAM_BOT_TOKEN" "$TELEGRAM_CHAT_ID" \
  "$N8N_WEBHOOK_URL" "$N8N_WEBHOOK_RESOLVE" "$N8N_WEBHOOK_TOKEN" \
  "${NODE_NAMES[@]}" <<'PYEOF'
import json
import re
import shutil
import sys
import datetime
import os
import subprocess
import urllib.request
import urllib.error

(power_file, thermal_file, storage_dir, pwrstat_file,
 out_file, state_file, telegram_token, telegram_chat_id,
 n8n_webhook_url, n8n_webhook_resolve, n8n_webhook_token) = sys.argv[1:12]
nodes = sys.argv[12:]

with open(power_file) as f:
    power = json.load(f)
with open(thermal_file) as f:
    thermal = json.load(f)

power_control = (power.get("PowerControl") or [{}])[0]
metrics = power_control.get("PowerMetrics") or {}

fans = []
for fan in thermal.get("Fans", []):
    name = fan.get("FanName") or fan.get("Name") or "Fan"
    reading = fan.get("Reading")
    unit = fan.get("ReadingUnits") or "RPM"
    fans.append({"name": name, "rpm": reading, "rpm_label": f"{reading} {unit}"})

# iDRAC's Redfish Thermal doesn't expose a max/duty-cycle field
# (MaxReadingRange is null) so there's no reliable basis for a true
# percentage - average RPM across all fans instead, one compact number.
readings = [f["rpm"] for f in fans if isinstance(f["rpm"], (int, float))]
fan_rpm_avg = round(sum(readings) / len(readings)) if readings else None

# VPS's own CPU/RAM - read directly off /proc since this script runs on the
# host itself, not in a container (Homepage's own "resources" widget can
# only ever show the Homepage *container's* usage, not the host's - this
# sidesteps that entirely).
cpu_count = os.cpu_count() or 1
load1, _, _ = os.getloadavg()
vps_cpu_pct = min(round(load1 / cpu_count * 100), 100)

meminfo = {}
with open("/proc/meminfo") as f:
    for line in f:
        key, _, rest = line.partition(":")
        meminfo[key] = int(rest.strip().split()[0])  # kB
mem_total_kb = meminfo.get("MemTotal", 0)
mem_avail_kb = meminfo.get("MemAvailable", 0)
mem_used_kb = mem_total_kb - mem_avail_kb
vps_mem_pct = round(mem_used_kb / mem_total_kb * 100) if mem_total_kb else None

vps = {
    "cpu_pct": vps_cpu_pct,
    "cpu_cores": cpu_count,
    "mem_pct": vps_mem_pct,
    "mem_used_gb": round(mem_used_kb / 1e6, 1),
    "mem_total_gb": round(mem_total_kb / 1e6, 1),
}

storage_pools = []
for node in nodes:
    path = os.path.join(storage_dir, f"{node}.json")
    try:
        with open(path) as f:
            data = json.load(f).get("data", [])
    except (FileNotFoundError, json.JSONDecodeError):
        data = []
    for store in data:
        if not store.get("active"):
            continue
        total = store.get("total") or 0
        used = store.get("used") or 0
        if not total:
            continue
        pct = round(used / total * 100)
        total_gb = round(total / 1e9)
        used_gb = round(used / 1e9)
        storage_pools.append({
            "name": f"{node}/{store.get('storage')}",
            "used_pct": pct,
            "used_pct_label": f"{pct}%",
            "usage_label": f"{used_gb} / {total_gb} GB",
        })

# This script runs directly on the VPS - no remote call needed for its own
# disk usage, unlike everything else above.
vps_disk = shutil.disk_usage("/")
vps_pct = round(vps_disk.used / vps_disk.total * 100)
storage_pools.append({
    "name": "oracle-vps/root",
    "used_pct": vps_pct,
    "used_pct_label": f"{vps_pct}%",
    "usage_label": f"{round(vps_disk.used / 1e9)} / {round(vps_disk.total / 1e9)} GB",
})

# Homepage shows one compact "worst case" figure instead of a stacked
# per-pool list (that list still exists above, just for the alerting loop
# below, keyed per pool so nothing is lost from monitoring).
fullest_pool = max(storage_pools, key=lambda p: p["used_pct"], default=None)
storage_summary = {
    "fullest_name": fullest_pool["name"] if fullest_pool else None,
    "fullest_pct": fullest_pool["used_pct"] if fullest_pool else None,
    "fullest_pct_label": fullest_pool["used_pct_label"] if fullest_pool else None,
}

# pwrstat output is fixed-width "Key.......... Value" lines. Splitting on
# "." and taking the last piece survives the padding regardless of how many
# dots there are, as long as the value itself has none (true for all of
# these fields).
ups = {}
try:
    with open(pwrstat_file) as f:
        pwrstat_text = f.read()
except FileNotFoundError:
    pwrstat_text = ""

for line in pwrstat_text.splitlines():
    line = line.strip()
    if line.startswith("State"):
        ups["state"] = line.split(".")[-1].strip()
    elif line.startswith("Power Supply by"):
        ups["power_supply_by"] = line.split(".")[-1].strip()
    elif line.startswith("Battery Capacity"):
        val = line.split(".")[-1].strip().replace("%", "").strip()
        ups["battery_pct"] = int(val) if val.isdigit() else None
    elif line.startswith("Remaining Runtime"):
        val = line.split(".")[-1].strip()
        m = re.match(r"(\d+)", val)
        ups["runtime_min"] = int(m.group(1)) if m else None
    elif line.startswith("Load"):
        val = line.split(".")[-1].strip()
        m = re.match(r"(\d+)\s*Watt\((\d+)\s*%\)", val)
        if m:
            ups["load_watts"] = int(m.group(1))
            ups["load_pct"] = int(m.group(2))

ups["reachable"] = bool(ups.get("state"))
ups["state"] = ups.get("state") or "Unreachable"

out = {
    "updated_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "power_watts": power_control.get("PowerConsumedWatts"),
    "power_avg_watts": metrics.get("AverageConsumedWatts"),
    "power_max_watts": metrics.get("MaxConsumedWatts"),
    "fan_rpm_avg": fan_rpm_avg,
    "fans": fans,
    "storage_pools": storage_pools,
    "storage_summary": storage_summary,
    "ups": ups,
    "vps": vps,
}

tmp_path = out_file + ".tmp"
with open(tmp_path, "w") as f:
    json.dump(out, f)
os.replace(tmp_path, out_file)

# --- Alerting: edge-triggered on state change, not on every 5-min poll. ---
# Straight to Telegram for now - no n8n/Ollama pipeline exists yet to route
# through, and building that branch before it exists is complexity with no
# payoff today. Revisit once n8n is live (later phase) if it's worth moving
# the non-critical ones (storage/fans) through AI triage instead.
STORAGE_WARN_PCT = 85
UPS_BATTERY_WARN_PCT = 30
ALERT_PREFIX = "\U0001F6A8"  # rotating light


def send_telegram(text):
    if not (telegram_token and telegram_chat_id):
        return
    url = f"https://api.telegram.org/bot{telegram_token}/sendMessage"
    payload = json.dumps({"chat_id": telegram_chat_id, "text": text}).encode()
    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=10)
    except (urllib.error.URLError, urllib.error.HTTPError):
        pass  # best-effort - a failed notification must not break the dashboard write above


def send_n8n_webhook(source, severity, summary):
    # n8n.k8s.merox.dev has no public DNS record by design - curl --resolve
    # points it at the internal Gateway's fixed IP without needing this
    # VPS's public resolver to know about it. Falls back to direct Telegram
    # (skipping AI triage) if n8n/the tunnel/cluster is unreachable, so a
    # storage or fan alert is never silently lost.
    if n8n_webhook_url and n8n_webhook_token:
        payload = json.dumps({"source": source, "severity": severity, "summary": summary})
        try:
            subprocess.run(
                [
                    "curl", "-sS", "-m", "10", "--retry", "2",
                    "--resolve", n8n_webhook_resolve,
                    "-H", f"Authorization: Bearer {n8n_webhook_token}",
                    "-H", "Content-Type: application/json",
                    "-d", payload,
                    n8n_webhook_url,
                ],
                check=True, capture_output=True, timeout=15,
            )
            return
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            pass  # fall through to direct Telegram below
    send_telegram(f"{ALERT_PREFIX} [{source}/{severity}] {summary}")


try:
    with open(state_file) as f:
        prev = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    prev = {}

new_state = {}

# UPS: any state change is worth knowing about, both onset and recovery.
prev_ups_state = prev.get("ups_state")
if ups["reachable"] and ups["state"] != prev_ups_state:
    if ups["state"] == "Normal" and prev_ups_state not in (None, "Normal"):
        send_telegram(f"✅ UPS power restored (was: {prev_ups_state}).")
    elif ups["state"] != "Normal":
        send_telegram(
            f"{ALERT_PREFIX} UPS state changed to '{ups['state']}' "
            f"(battery {ups.get('battery_pct')}%, runtime ~{ups.get('runtime_min')} min)."
        )
new_state["ups_state"] = ups["state"] if ups["reachable"] else prev_ups_state

battery_pct = ups.get("battery_pct")
prev_low_battery = prev.get("ups_low_battery", False)
low_battery = ups["state"] != "Normal" and battery_pct is not None and battery_pct < UPS_BATTERY_WARN_PCT
if low_battery and not prev_low_battery:
    send_telegram(f"{ALERT_PREFIX} UPS battery below {UPS_BATTERY_WARN_PCT}% ({battery_pct}%) - runtime running out.")
new_state["ups_low_battery"] = low_battery

# ZFS/storage pools: edge-triggered per pool, keyed by name so one pool
# crossing the threshold doesn't get lost among the others.
prev_storage_high = prev.get("storage_high", {})
storage_high = {}
for pool in storage_pools:
    key = pool["name"]
    is_high = pool["used_pct"] >= STORAGE_WARN_PCT
    storage_high[key] = is_high
    if is_high and not prev_storage_high.get(key, False):
        send_n8n_webhook("storage", "warning", f"{key} is {pool['used_pct_label']} full (threshold {STORAGE_WARN_PCT}%).")
    elif not is_high and prev_storage_high.get(key, False):
        send_n8n_webhook("storage", "info", f"{key} back under {STORAGE_WARN_PCT}% ({pool['used_pct_label']}).")
new_state["storage_high"] = storage_high

# iDRAC fans: alert on a dead fan (reads 0 while others don't) or on the
# whole thermal reading going unreadable - not on an absolute RPM floor,
# since normal RPM baseline for this chassis hasn't been profiled.
dead_fans = [f["name"] for f in fans if f.get("rpm") == 0]
fan_problem = bool(dead_fans) or (not fans and prev.get("fan_rpm_avg_was_known"))
prev_fan_problem = prev.get("fan_problem", False)
if fan_problem and not prev_fan_problem:
    detail = f"dead fan(s): {', '.join(dead_fans)}" if dead_fans else "thermal readings unavailable"
    send_n8n_webhook("hardware", "warning", f"R730xd fan issue - {detail}.")
elif not fan_problem and prev_fan_problem:
    send_n8n_webhook("hardware", "info", "R730xd fans back to normal.")
new_state["fan_problem"] = fan_problem
new_state["fan_rpm_avg_was_known"] = bool(fans)

# Docker containers on this VPS: anything not "Up" (exited/restarting/dead)
# or marked unhealthy by its own healthcheck is worth flagging. No hardcoded
# name list - whatever's actually running in the compose stack is what's
# checked, so a new service is covered automatically.
def docker_unhealthy():
    try:
        out = subprocess.run(
            ["docker", "ps", "-a", "--format", "{{ '{{.Names}}' }}\t{{ '{{.Status}}' }}"],
            capture_output=True, text=True, timeout=10, check=True,
        ).stdout
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
        return {}
    bad = {}
    for line in out.strip().splitlines():
        name, _, status = line.partition("\t")
        if not status.startswith("Up") or "(unhealthy)" in status:
            bad[name] = status
    return bad

containers_bad = docker_unhealthy()
prev_containers_bad = prev.get("containers_bad", {})
for name, status in containers_bad.items():
    if name not in prev_containers_bad:
        send_n8n_webhook("docker", "critical", f"Container '{name}' is {status}.")
for name in prev_containers_bad:
    if name not in containers_bad:
        send_n8n_webhook("docker", "info", f"Container '{name}' recovered.")
new_state["containers_bad"] = containers_bad

# WAN/Tailscale: proof this VPS can still reach home, independent of
# anything hosted there. Straight to Telegram like UPS above - if home's
# down, n8n/Prometheus/Ollama (all home-hosted) are down with it, so routing
# this particular check through them would mean it never fires when it
# matters most.
HOME_TAILSCALE_IP = "100.99.34.94"  # merox-homelab (home firewall/router)


def home_reachable():
    # `tailscale status`'s peer table is a passive/cached view - it can sit
    # stuck on "offline" for 10+ minutes on a NAT keepalive hiccup even
    # though the peer is actually reachable (confirmed by hand: `tailscale
    # ping` succeeded instantly while `status` still showed it offline).
    # An active ping forces a real handshake instead of trusting the cache.
    try:
        out = subprocess.run(
            ["tailscale", "ping", "--c", "1", HOME_TAILSCALE_IP],
            capture_output=True, text=True, timeout=15,
        ).stdout
        return "pong from" in out
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None  # unknown (command/parse failure) - don't alert on ambiguous data


home_up = home_reachable()
prev_home_up = prev.get("home_up", True)
prev_down_streak = prev.get("home_down_streak", 0)
# A single "offline" reading can just be a Tailscale handshake/DERP blip, not
# a real outage - require 2 consecutive down checks (~5 min apart) before
# alerting. Recovery still fires immediately, no need to debounce good news.
if home_up is None:
    down_streak = prev_down_streak
elif home_up:
    down_streak = 0
else:
    down_streak = prev_down_streak + 1

confirmed_down = down_streak >= 2
new_home_up_confirmed = not confirmed_down
if new_home_up_confirmed != prev_home_up:
    if new_home_up_confirmed:
        send_telegram("✅ Home network/Tailscale back online.")
    else:
        send_telegram(
            f"{ALERT_PREFIX} Home network unreachable via Tailscale (merox-homelab "
            "offline, 2 consecutive checks) - n8n/Prometheus/Ollama are hosted "
            "there too, so alerting through them may be down as well."
        )
new_state["home_up"] = new_home_up_confirmed
new_state["home_down_streak"] = down_streak

state_tmp = state_file + ".tmp"
with open(state_tmp, "w") as f:
    json.dump(new_state, f)
os.replace(state_tmp, state_file)
PYEOF
