# {{ ansible_managed }}
[Unit]
Description=Rebuild the geoblock ipset and DOCKER-USER rule
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/geoblock-refresh.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
