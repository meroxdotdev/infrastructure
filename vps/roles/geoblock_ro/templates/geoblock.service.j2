# {{ ansible_managed }}
[Unit]
Description=Rebuild the geoblock ipset and its firewall rule
After=network-online.target {{ geoblock_chain_unit }}
Wants=network-online.target
Requires={{ geoblock_chain_unit }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/geoblock-refresh.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
