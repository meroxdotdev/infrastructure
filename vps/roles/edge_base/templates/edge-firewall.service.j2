# {{ ansible_managed }}
[Unit]
Description=Public-edge firewall chain ({{ edge_firewall_chain }})
# netfilter-persistent restores the Oracle base ruleset and flushes the filter
# table doing it. Running before it would leave nothing behind.
After=netfilter-persistent.service
# Same early slot as netfilter-persistent: the chain has to exist before
# fail2ban, geoblock and docker start writing into or around it.
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/edge-firewall.sh

[Install]
WantedBy=multi-user.target
