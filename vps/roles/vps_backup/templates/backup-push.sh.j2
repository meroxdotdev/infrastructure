#!/bin/bash
# Push the VPS service backups (Authentik, Joplin, Guacamole, Traefik, Pi-hole,
# Homepage, Portainer) to the NAS, the landing spot every producer writes to.
# The NAS keeps the latest copy; history is the vault's job — see
# docs/plan-nas-hot-r730-cold.md.
#
# DSM user `vps`: not an administrator, rsync + SFTP only, write access to
# backups/ only, key accepted only from 10.57.57.1 (the VPS arrives through
# pfSense's NAT). Two DSM details this depends on:
#   - the full path /volume1/... — /backups/... is read as an rsync module and
#     fails without a message;
#   - no -p/-o/-g: preserving Unix modes would replace DSM's ACLs and leave
#     files the vault cannot read. --chmod sets sane modes instead.
# Deployed by ansible (vps_backup role).
set -euo pipefail

SSH_OPTS="ssh -i {{ vps_backup_ssh_key }} -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

rsync -rlt --delete --chmod=D755,F644 -e "$SSH_OPTS" \
  "{{ vps_backup_root }}/" "{{ vps_backup_nas_user }}@{{ vps_backup_nas_host }}:{{ vps_backup_nas_path }}/"

# TEMPORARY, remove in phase 7: the R730xd's restic run is still the off-site
# path until the vault takes over. rrsync there roots this key at
# /media/backups/oracle-vps, so the remote path is relative to it.
rsync -a --delete -e "$SSH_OPTS" "{{ vps_backup_root }}/" "root@{{ vps_backup_r730xd_host }}:/srv-backups/"

echo "$(date -Is) backup push to the NAS completed"
