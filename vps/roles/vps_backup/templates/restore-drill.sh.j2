#!/bin/bash
# Monthly restore drill: proves the latest Authentik/Joplin dumps are actually
# restorable, not just that pg_dump/gzip exited 0. Spins up a throwaway
# postgres container per service (no host port, --rm cleans it and its
# anonymous data volume), imports the newest dump, checks the restored schema
# has tables, tears down. Never touches the live DBs or containers.
# Deployed by ansible (vps_backup role).
set -uo pipefail

HC_URL="{{ vps_backup_hc_restore_drill_url | default('') }}"
FAIL=0

ping_hc() {
  [ -n "$HC_URL" ] || return 0
  curl -fsS -m 10 --retry 3 -o /dev/null "$HC_URL$1" || true
}

drill_one() {
  local svc="$1" image="$2" user="$3" db="$4"
  local dump
  dump=$(ls -1t "/srv/backups/$svc/${svc}_"*.sql.gz 2>/dev/null | head -1)
  if [ -z "${dump:-}" ]; then
    echo "✗ $svc: no dump found in /srv/backups/$svc/, skipping"
    FAIL=1
    return
  fi

  local ctr="restore-drill-$svc"
  docker rm -f "$ctr" >/dev/null 2>&1 || true
  docker run -d --rm --name "$ctr" \
    -e POSTGRES_USER="$user" -e POSTGRES_PASSWORD=drill -e POSTGRES_DB="$db" \
    "$image" >/dev/null

  # Over TCP, never the socket. The image's entrypoint first runs a temporary
  # server on the unix socket only (listen_addresses=''), creates the DB, then
  # stops it and starts the real one. A socket check passes during that first
  # phase, and a restore started there is cut off when it stops — which is
  # why the drill failed for Authentik one month and Joplin the next, with
  # both dumps intact.
  local ready=0
  for _ in $(seq 1 60); do
    if docker exec "$ctr" pg_isready -h 127.0.0.1 -U "$user" >/dev/null 2>&1; then ready=1; break; fi
    sleep 1
  done
  if [ "$ready" -ne 1 ]; then
    echo "✗ $svc: throwaway postgres never became ready"
    docker stop "$ctr" >/dev/null 2>&1
    FAIL=1
    return
  fi

  # ON_ERROR_STOP so a SQL error fails here, with its message in the log,
  # instead of psql exiting 0 past it. PIPESTATUS names the stage that failed:
  # the previous failures left no message at all.
  zcat "$dump" | docker exec -i -e PGPASSWORD=drill "$ctr" \
      psql -q -v ON_ERROR_STOP=1 -h 127.0.0.1 -U "$user" -d "$db" \
      >"/tmp/restore-drill-$svc.log" 2>&1
  local rc=("${PIPESTATUS[@]}")
  if [ "${rc[0]}" -ne 0 ] || [ "${rc[1]}" -ne 0 ]; then
    echo "✗ $svc: restore FAILED (zcat=${rc[0]} psql=${rc[1]}, see /tmp/restore-drill-$svc.log) — dump: $dump"
    docker stop "$ctr" >/dev/null 2>&1
    FAIL=1
    return
  fi

  local tables
  tables=$(docker exec -e PGPASSWORD=drill "$ctr" psql -qtA -U "$user" -d "$db" -c \
    "SELECT count(*) FROM information_schema.tables WHERE table_schema='public';" 2>/dev/null)
  docker stop "$ctr" >/dev/null 2>&1

  if [ "${tables:-0}" -gt 0 ] 2>/dev/null; then
    echo "✓ $svc: restore drill OK ($dump, $tables tables)"
  else
    echo "✗ $svc: restored but found 0 tables — dump: $dump"
    FAIL=1
  fi
}

drill_one authentik postgres:16-alpine authentik authentik
drill_one joplin postgres:18 joplin joplin

if [ "$FAIL" -eq 0 ]; then
  ping_hc ""
  echo "$(date -Is) restore drill: all OK"
  exit 0
else
  ping_hc "/fail"
  echo "$(date -Is) restore drill: FAILURES detected"
  exit 1
fi
