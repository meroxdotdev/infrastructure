#!/bin/bash
# The nightly backup chain, one ping.
#
# Joplin dump, then the extras tar, then the push to the R730xd — a single
# 15-minute sequence that used to carry three healthchecks. They fail as a
# unit and are investigated as a unit, so three checks were three places to
# look for one answer. If the push succeeds, everything before it did too.
#
# Each step exits non-zero on failure (they all run set -euo pipefail); that
# exit code is the whole interface. None of them ping anything themselves.
set -uo pipefail

HC_URL="{{ vps_backup_hc_nightly_url | default('') }}"
FAILED=""

for s in backup-joplin backup-vps-extras backup-push-r730xd; do
  if ! /usr/local/bin/$s.sh >> /var/log/nightly-backup.log 2>&1; then
    FAILED="$FAILED $s"
    break          # the push has nothing to send if a producer failed
  fi
done

if [ -n "$FAILED" ]; then
  echo "$(date '+%F %T') FAILED:$FAILED"
  [ -n "$HC_URL" ] && curl -fsS -m 10 --retry 3 -o /dev/null \
    --data-raw "failed:$FAILED" "$HC_URL/fail" || true
  exit 1
fi

echo "$(date '+%F %T') ok (joplin, extras, push to r730xd)"
[ -n "$HC_URL" ] && curl -fsS -m 10 --retry 3 -o /dev/null "$HC_URL" || true
