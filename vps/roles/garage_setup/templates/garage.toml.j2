metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
{% if garage_meta_snapshot_interval %}
# The data directory alone cannot be read back: Garage needs its metadata to
# know which block belongs to which object. Consistent snapshots of it go to a
# directory that is backed up with the data.
metadata_auto_snapshot_interval = "{{ garage_meta_snapshot_interval }}"
metadata_snapshots_dir = "/var/lib/garage/meta-snapshots"
{% endif %}

replication_factor = {{ garage_replication_factor }}

rpc_bind_addr = "0.0.0.0:{{ garage_rpc_port }}"
rpc_public_addr = "127.0.0.1:{{ garage_rpc_port }}"
rpc_secret = "{{ garage_rpc_secret }}"

[s3_api]
s3_region = "{{ garage_region }}"
api_bind_addr = "0.0.0.0:{{ garage_s3_port }}"
root_domain = ".s3.garage"

[admin]
api_bind_addr = "0.0.0.0:{{ garage_admin_port }}"
admin_token = "{{ garage_admin_token }}"
