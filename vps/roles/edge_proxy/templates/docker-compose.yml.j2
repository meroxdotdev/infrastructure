# {{ ansible_managed }}

services:
  traefik:
    image: {{ edge_proxy_image }}
    container_name: traefik
    restart: unless-stopped
    # No bridge, no published ports: packets reach the firewall carrying the
    # port they were sent to, so geoblock/fail2ban/egress-guard match on it
    # directly — none of the DNAT contortions DOCKER-USER needs on vps01.
    # NET_BIND_SERVICE below is still needed: 443 is privileged too.
    network_mode: host
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    # The only capability needed, and only because :80/:443 are privileged.
    # Host networking hands over the whole network namespace, so drop the rest.
    cap_add:
      - NET_BIND_SERVICE
    environment:
      CF_DNS_API_TOKEN_FILE: /run/secrets/cf_api_token
    secrets:
      - cf_api_token
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ edge_proxy_dir }}/data/traefik.yml:/traefik.yml:ro
      - {{ edge_proxy_dir }}/data/acme.json:/acme.json
      - {{ edge_proxy_dir }}/config:/config:ro
      # Access log lives on the host so fail2ban, which runs outside the
      # container, can read it.
      - {{ traefik_log_dir }}:/var/log/traefik
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

secrets:
  cf_api_token:
    file: ./cf_api_token.txt
