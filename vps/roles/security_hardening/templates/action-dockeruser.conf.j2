# {{ ansible_managed }}
# Bans in the DOCKER-USER chain, not INPUT.
#
# fail2ban's stock actions write to INPUT. Docker publishes container ports
# through its own chains and never traverses INPUT, so a stock ban silently
# does nothing for anything behind the reverse proxy - the same trap the
# geoblock rule fell into twice.
#
# Matches the container address and container-side port for the same reason:
# docker DNATs in nat PREROUTING, so FORWARD already sees the translated port.
#
# An ipset holds the banned addresses, so bans are a set membership change
# rather than one iptables rule per address.
[Definition]
actionstart = ipset create <ipmset> hash:ip timeout <bantime> -exist
              iptables -I DOCKER-USER 1 -p tcp -d <target_ip> --dport <target_port> -m set --match-set <ipmset> src -j DROP

actionstop  = iptables -D DOCKER-USER -p tcp -d <target_ip> --dport <target_port> -m set --match-set <ipmset> src -j DROP
              ipset flush <ipmset>
              ipset destroy <ipmset>

actioncheck = iptables -C DOCKER-USER -p tcp -d <target_ip> --dport <target_port> -m set --match-set <ipmset> src -j DROP

actionban   = ipset add <ipmset> <ip> timeout <bantime> -exist
{% if fail2ban_notify_url %}
              curl -fsS -m 10 --retry 2 --data-raw "fail2ban: banned <ip> for repeated Jellyfin login failures" "{{ fail2ban_notify_url }}/fail" || true
{% endif %}

actionunban = ipset del <ipmset> <ip> -exist

[Init]
ipmset = f2b-jellyfin
target_ip = {{ fail2ban_target_ip }}
target_port = {{ fail2ban_target_port }}
bantime = {{ fail2ban_jellyfin_bantime }}
