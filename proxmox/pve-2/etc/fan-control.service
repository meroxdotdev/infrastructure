# Lives at /etc/systemd/system/fan-control.service on pve.
# The logic is in the script; what matters here is that every failure mode ends
# in Dell's algorithm rather than in stuck fans.
[Unit]
Description=Quiet the chassis fans (IPMI manual mode with a thermal fallback)
Documentation=https://github.com/meroxdotdev/infrastructure/blob/main/proxmox/pve-2/scripts/fan-control.sh
After=multi-user.target

[Service]
Type=simple
ExecStart=/root/scripts/fan-control.sh
# The script hands cooling back on every exit it can see; this covers the ones
# it cannot, SIGKILL included.
ExecStopPost=/usr/bin/ipmitool raw 0x30 0x30 0x01 0x01
Restart=always
RestartSec=15
# Restart=always covers a script that dies; this covers one that wedges. The
# loop pings once per 30 s cycle; two missed cycles and systemd kills it, which
# runs ExecStopPost above.
WatchdogSec=90
NotifyAccess=all

[Install]
WantedBy=multi-user.target
