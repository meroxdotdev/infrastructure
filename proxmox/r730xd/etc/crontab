# The whole backup chain runs on UTC.
#
# Why: the Oracle VPS, the k8s cluster and Nextcloud AIO all schedule in UTC
# and cannot be changed. While pve ran on local time the two sets coincided in
# summer by accident, but in winter the UTC jobs dropped an hour and the backup
# window split in two - the SAS pool woke twice a night instead of once.
#
# With CRON_TZ=UTC everything moves together and the window stays one block
# regardless of DST. Summer 02:40-03:25 local, winter 01:40-02:25.
#
# Order matters: every source writes before restic reads at 00:10.

# REDACTED - the weekly Synology push time reveals the NAS wake window, which
# this repo deliberately does not publish. Real line is in
# /root/PRIVATE-NOTES.md on pve (restic backs it up). Restoring from this file
# alone therefore leaves the weekly leg unscheduled - add it back.
#
# It must go HERE, above CRON_TZ, so it keeps running on local time. The
# Synology DSM wake schedule is set in the NAS's own local time and does not
# follow this file; a UTC line would fire before the NAS wakes every winter
# Sunday, and weekly-push-to-synology.sh has no heartbeat, so that failure
# would be silent.
# <min> <hr> * * <day> /root/scripts/weekly-push-to-synology.sh

CRON_TZ=UTC

# --- nightly backup window (UTC) ---
55 23 * * * /usr/bin/vzdump 101 --mode snapshot --compress zstd --storage sas-backups --prune-backups keep-last=1 >> /var/log/vzdump-cron.log 2>&1
1 0 * * *   /root/scripts/garage-meta-nightly-copy.sh >> /var/log/garage-meta-copy.log 2>&1
3 0 * * *   /root/scripts/etcd-snapshot.sh >> /var/log/etcd-snapshot.log 2>&1
5 0 * * *   /root/scripts/zfs-snapshot-backups.sh >> /var/log/zfs-snapshot.log 2>&1
10 0 * * *  /root/scripts/restic-push-oracle.sh >> /var/log/restic-push.log 2>&1
20 0 * * *  /root/scripts/sas-health-check.sh >> /var/log/sas-health.log 2>&1
25 0 * * *  /root/scripts/spindown-drift-check.sh >> /var/log/spindown-drift.log 2>&1

# --- monthly ---
0 2 1 * *   /root/scripts/restic-restore-drill.sh >> /var/log/restic-restore-drill.log 2>&1

# --- timezone-independent ---
*/5 * * * * /root/scripts/heartbeat-ping.sh >> /var/log/heartbeat-ping.log 2>&1
