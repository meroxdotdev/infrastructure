# Client ACLs are per-host, not the whole LAN subnet. Anything on
# 10.57.57.0/24 could previously mount every export below; combined with
# no_root_squash that meant any device in the house had root on the backup
# tree. Narrowed 2026-08-11 to the hosts that actually mount, verified
# against live nfsd peers first.
#
#   10.57.57.80/82/84  Talos nodes (all pod mounts originate here)
#
# Adding a client means adding its IP here, not widening back to /24.
/media/library                  10.57.57.80(rw,sync,no_subtree_check,no_root_squash) 10.57.57.82(rw,sync,no_subtree_check,no_root_squash) 10.57.57.84(rw,sync,no_subtree_check,no_root_squash)
/media/backups                  10.57.57.80(rw,sync,no_subtree_check,no_root_squash,crossmnt) 10.57.57.82(rw,sync,no_subtree_check,no_root_squash,crossmnt) 10.57.57.84(rw,sync,no_subtree_check,no_root_squash,crossmnt)
/media/backups/longhorn-garage  10.57.57.80(rw,sync,no_subtree_check,no_root_squash,crossmnt) 10.57.57.82(rw,sync,no_subtree_check,no_root_squash,crossmnt) 10.57.57.84(rw,sync,no_subtree_check,no_root_squash,crossmnt)
/media/isos                     10.57.57.80(ro,sync,no_subtree_check,no_root_squash) 10.57.57.82(ro,sync,no_subtree_check,no_root_squash) 10.57.57.84(ro,sync,no_subtree_check,no_root_squash)
/media/photos                   10.57.57.80(rw,sync,no_subtree_check,no_root_squash) 10.57.57.82(rw,sync,no_subtree_check,no_root_squash) 10.57.57.84(rw,sync,no_subtree_check,no_root_squash)


# Public Jellyfin library, on the SSD pool so streaming to friends never wakes
# the SAS array. Read-only: the instance behind it is the only thing reachable
# from the internet and has no reason to write. Quota caps it at 400G so it
# cannot crowd out the VM disks that share rpool.
/public/library                 10.57.57.80(ro,sync,no_subtree_check,no_root_squash) 10.57.57.82(ro,sync,no_subtree_check,no_root_squash) 10.57.57.84(ro,sync,no_subtree_check,no_root_squash)
