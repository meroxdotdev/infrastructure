# Copy to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored

proxmox_url          = "https://10.57.57.250:8006"
proxmox_token_id     = "root@pam!terraform"   # create at: Proxmox → Datacenter → API Tokens
proxmox_token_secret = "your-token-secret-here"

# REQUIRED for DR on Proxmox homelab (fixed MACs = prod node MACs from talconfig.yaml):
# Target: pve/R730xd (huge headroom, use since prod is already down there
# during a drill — see DR.md "Which host to target").
proxmox_nodes = ["pve", "pve", "pve"]
disk_storage  = "local-zfs"

# Fixed MACs = prod node MACs (from talos/talconfig.yaml hardwareAddr).
# ALWAYS verify these against talconfig.yaml before running — they drift
# whenever a prod VM's NIC changes. Wrong MAC = DR node never gets its
# static IP (task dr:apply-talos-configs can't match it to a config).
# This ensures: (a) MAC→config matching in task dr:apply-talos-configs works,
# and (b) no talconfig patching is needed — prod IPs/MACs are reused.
# PREREQUISITE: prod cluster VMs must be stopped before DR.
node_macs = ["bc:24:11:a7:ba:13", "bc:24:11:a5:4b:9e", "bc:24:11:96:87:40"]
node_ips  = ["10.57.57.80", "10.57.57.82", "10.57.57.84"]
node_vip  = "10.57.57.88"

# Optional overrides:
# vmid_start     = 810
# vm_cores       = 4
# vm_memory_mb   = 49152  # matches prod exactly - 238GB+ free on pve once prod VMs are stopped
# iso_storage    = "media-isos"  # pve/R730xd

# KNOWN WORKING (re-verified during the 2026-08-03 DR drill):
# - pve (R730xd): disk_storage 'local-zfs', iso_storage 'media-isos' (the
#   'local' storage there only has content=snippets, no iso support).
# - Proxmox API tokens for terraform don't survive between hosts if you
#   ever add a second one back - re-run `pveum user token add root@pam
#   terraform --privsep 0` on whichever host you target.
