# DR target: pve (R730xd). Default since 2026-09-01 — production moved to
# px-0, so a drill on pve does not touch the live cluster and has 251 GB of
# RAM to play with.
#
# To drill on px-0 instead, swap in terraform.tfvars.px-0 and expect to stop
# VM 810 first: it is kubernetes-1, the live cluster.

proxmox_url          = "https://10.57.57.250:8006"
proxmox_token_id     = "root@pam!terraform"
proxmox_token_secret = "REPLACE-ME"

proxmox_nodes = ["pve"]
disk_storage  = "local-zfs"
iso_storage   = "media-isos"
vmid_start    = 820   # 810 is kubernetes-1, the live cluster on px-0 — do not reuse

# One entry per node in talconfig.yaml, with the same MAC —
# dr:apply-talos-configs aborts if the counts disagree, and Talos selects its
# NIC by MAC. Since the 2026-09-01 collapse that means exactly one: kubernetes-1.
node_macs = ["bc:24:11:00:57:81"]
node_ips  = ["10.57.57.80"]
node_vip  = "10.57.57.88"

# The DR node carries the whole cluster: 32 GiB leaves pods Pending on
# Insufficient memory against 38 GiB of requests.
vm_cores      = 14
vm_memory_mb  = 45056
vm_disk_gb    = 250
talos_version = "v1.13.9"
