# DR target: pve-1, the Beelink — the only host with the RAM for a node that
# carries the whole cluster (62 GB). A cluster that needs DR is a cluster that
# is gone, so VM 810 (kubernetes-1) being stopped first costs nothing; for a
# drill, it means the whole homelab is down while it runs.
#
# Until 2026-10-02 this pointed at the R730xd, which had 251 GB to spare. That
# machine is now the TrueNAS vault and runs no Proxmox.

proxmox_url          = "https://10.57.57.254:8006"
proxmox_token_id     = "root@pam!terraform"
proxmox_token_secret = "REPLACE-ME"

proxmox_nodes = ["pve-1"]
disk_storage  = "cluster-storage"
iso_storage   = "local-data"
vmid_start    = 820   # 810 is kubernetes-1 — do not reuse

# DR restores one node: the MAC of kubernetes-1, so Talos picks its config.
# dr:apply-talos-configs only requires every MAC here to exist in
# talconfig.yaml, not the same count.
node_macs = ["bc:24:11:00:57:81"]
node_ips  = ["10.57.57.80"]
node_vip  = "10.57.57.88"

# The DR node carries the whole cluster: 32 GiB leaves pods Pending on
# Insufficient memory against 38 GiB of requests.
vm_cores      = 14
vm_memory_mb  = 45056
vm_disk_gb    = 250
talos_version = "v1.13.9"
