# Pinned versions for the hard-way cluster. The `# renovate:` lines are the
# same annotation format the root .renovaterc.json5 already parses, so
# Renovate opens PRs for these like it does for talos/talenv.yaml.
#
# Kubernetes and Cilium move together, exactly as in prod: Cilium 1.20 is
# tested up to Kubernetes 1.36. Do not take a Kubernetes minor here that the
# Cilium below does not list — https://docs.cilium.io/en/stable/network/kubernetes/requirements/
#
# These were current when the lab was written. Check each releases page before
# your first run; a newer patch is always fine.

# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBERNETES_VERSION=v1.36.5
# renovate: datasource=github-releases depName=etcd-io/etcd
ETCD_VERSION=v3.6.5
# renovate: datasource=github-releases depName=containerd/containerd
CONTAINERD_VERSION=v2.1.4
# renovate: datasource=github-releases depName=opencontainers/runc
RUNC_VERSION=v1.3.3
# renovate: datasource=github-releases depName=containernetworking/plugins
CNI_PLUGINS_VERSION=v1.8.0
# renovate: datasource=github-releases depName=kubernetes-sigs/cri-tools
CRICTL_VERSION=v1.34.0
# renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
CILIUM_CHART_VERSION=1.20.4
# renovate: datasource=github-releases depName=cilium/cilium-cli
CILIUM_CLI_VERSION=v0.20.1
# renovate: datasource=github-releases depName=kubernetes-sigs/gateway-api
GATEWAY_API_VERSION=v1.6.3
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.1
# renovate: datasource=github-releases depName=helmfile/helmfile
HELMFILE_VERSION=v1.8.2
# renovate: datasource=github-releases depName=mikefarah/yq
YQ_VERSION=v4.54.1
