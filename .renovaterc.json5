{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  dependencyDashboardHeader: "**Before approving the `talos` group:** Talos v1.14 serves Kubernetes **1.33-1.37** only — [support matrix](https://docs.siderolabs.com/talos/v1.14/getting-started/support-matrix). A Kubernetes minor also needs Cilium to list it as tested ([requirements](https://docs.cilium.io/en/stable/network/kubernetes/requirements/)) — Cilium 1.20 stops at 1.36, which is why kubelet is capped below 1.37 in `allowedVersions`.",
  schedule: ["every weekend"],
  // learn/lab/k8s-lab is a template for a separate repo with its own
  // .renovaterc.json5 and an argocd manager this config lacks: bumped from here,
  // its helmfile would move while its Applications stayed behind.
  ignorePaths: ["**/*.sops.*", "learn/lab/k8s-lab/**"],
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  packageRules: [
    {
      description: "Talos and Kubernetes are one decision, not two. The Talos minor version fixes which Kubernetes versions can run at all (v1.14 -> 1.33-1.37), but Renovate sees two unrelated packages. Group everything in talenv.yaml so the support matrix is checked once, against both. Talos is tracked as GitHub releases: ghcr.io/siderolabs/installer stopped being published with v1.14 (the nodes install from factory.talos.dev), so watching that image would have frozen Renovate at v1.13.x.",
      matchFileNames: ["talos/talenv.yaml"],
      groupName: "talos",
    },
    {
      description: "Before approving: check the Talos support matrix, and reject any kubelet the running Talos minor cannot serve. Renovate raised kubelet to v1.37.0 on 2026-08-29 (532e9c0) and it was merged unchecked; Talos 1.13.9 tops out at Kubernetes 1.36, so every node generated from talenv.yaml would have joined with a kubelet newer than the API server. Approval is the only gate - nothing else blocks an unsupported pair. Patch bumps (1.14.4 -> 1.14.5) still flow normally.",
      matchFileNames: ["talos/talenv.yaml"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
    },
    {
      description: "A hard ceiling, because approval is not a gate. dependencyDashboardApproval was tried and failed twice: v1.37.0 merged unchecked on 2026-08-29 (532e9c0), pinned back in 9d956d2, then arrived again on 2026-09-05 in the grouped `talos` PR (da53820). Grouping is why the second one got through - a gated kubelet minor rides along on the ungated Talos patch's branch, and the result reads like any other bump. Same lesson as the Immich Postgres rule below: when a pair is invalid or unvalidated rather than a judgement call, the honest setting is a constraint, not a question. Talos was the limit until 2026-10-26; the cluster then moved to Talos 1.14, which serves 1.37, and the limit became Cilium: 1.20.x lists Kubernetes 1.33-1.36 as tested, and a CNI failure takes the whole cluster with it while a Kubernetes minor cannot be rolled back. Raise this bound in the same commit that moves Cilium to a release that lists 1.37, never before.",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      allowedVersions: "<1.37.0",
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )",
    },
    {
      matchDatasources: ["docker"],
      semanticCommitScope: "container",
      commitMessageTopic: "image {{depName}}",
    },
    {
      matchDatasources: ["helm"],
      semanticCommitScope: "helm",
      commitMessageTopic: "chart {{depName}}",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
    },
    {
      matchDatasources: ["github-releases"],
      semanticCommitScope: "github-release",
      commitMessageTopic: "release {{depName}}",
    },
    {
      matchManagers: ["mise"],
      semanticCommitScope: "mise",
      commitMessageTopic: "tool {{depName}}",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Disable qbtools monitoring",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/buroa/qbtools"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      description: "Process OCI dependencies",
      customType: "regex",
      managerFilePatterns: ["/\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: ["oci://(?<depName>[^:]+):(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
    {
      description: "Process annotated dependencies",
      customType: "regex",
      managerFilePatterns: [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        // # renovate: datasource=github-releases depName=k3s-io/k3s
        // k3s_release_version: &version v1.29.0+k3s1
        // # renovate: datasource=helm depName=cilium repository=https://helm.cilium.io
        // version: 1.15.1
        // # renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
        // KUBERNETES_VERSION=v1.31.1
        // An optional quote before the value: Ansible defaults pin "2026.8.2", and
        // with the quotes captured Renovate saw no valid version and skipped the line.
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\\s\"']+)",
        // # renovate: datasource=docker depName=ghcr.io/prometheus-operator/prometheus-operator
        // https://raw.githubusercontent.com/prometheus-operator/prometheus-operator/v0.80.0/example/prometheus-operator-crd/monitoring.coreos.com_alertmanagerconfigs.yaml
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
  ],
}